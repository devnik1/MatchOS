---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';

const fixtures = [
  {
    slug: 'brazil-vs-germany',
    homeTeam: 'Brazil',
    awayTeam: 'Germany',
    homeFlag: '🇧🇷',
    awayFlag: '🇩🇪',
    date: '14 Jul 2026',
    time: '21:00',
    stage: 'Quarter-Final'
  },
  {
    slug: 'france-vs-spain',
    homeTeam: 'France',
    awayTeam: 'Spain',
    homeFlag: '🇫🇷',
    awayFlag: '🇪🇸',
    date: '15 Jul 2026',
    time: '20:00',
    stage: 'Semi-Final'
  },
  {
    slug: 'argentina-vs-brazil',
    homeTeam: 'Argentina',
    awayTeam: 'Brazil',
    homeFlag: '🇦🇷',
    awayFlag: '🇧🇷',
    date: '18 Jul 2026',
    time: '19:30',
    stage: 'Final'
  }
];
---

<Layout title="MatchIQ — Pre-Match Briefings">
  <div class="mx-auto flex min-h-screen max-w-7xl flex-col px-4 py-6 sm:px-6 lg:px-8">
    <Navigation />

    <main class="flex-1 py-8 sm:py-12">
      <section class="mb-10 rounded-[2rem] border border-[#f5f0e6]/20 bg-[#171717] p-6 shadow-[8px_8px_0_0_#f5f0e6] sm:p-10">
        <div class="flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between">
          <div class="max-w-2xl">
            <p class="mb-4 text-sm font-semibold uppercase tracking-[0.3em] text-[#f0c14b]">Pre-match briefing</p>
            <h1 class="mb-4 text-4xl font-black leading-none sm:text-5xl lg:text-6xl">Five minutes before kickoff. Everything you need to know.</h1>
            <p class="max-w-xl text-lg text-[#d8d0c1]">MatchIQ turns the biggest fixtures into premium, editorial-style previews designed for new fans who want context fast.</p>
          </div>
          <div class="rounded-[1.5rem] border border-[#f5f0e6]/20 bg-[#222222] p-6">
            <p class="text-sm uppercase tracking-[0.25em] text-[#7fd8ff]">Next kickoff</p>
            <p class="mt-2 text-3xl font-black">Brazil vs Germany</p>
            <p class="mt-3 text-sm text-[#d8d0c1]">14 Jul 2026 · 21:00 · Quarter-Final</p>
          </div>
        </div>
      </section>

      <section class="mb-10">
        <div class="mb-6 flex items-end justify-between">
          <div>
            <p class="text-sm font-semibold uppercase tracking-[0.3em] text-[#ff6b6b]">Upcoming fixtures</p>
            <h2 class="text-2xl font-black sm:text-3xl">Browse the next matches</h2>
          </div>
          <a href="#" class="text-sm font-semibold underline decoration-[#f0c14b] underline-offset-4">View all</a>
        </div>
        <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
          {fixtures.map((fixture) => (
            <a href={`/match/${fixture.slug}`} class="group block rounded-[1.5rem] border border-[#f5f0e6]/20 bg-[#171717] p-5 transition duration-200 hover:-translate-y-1 hover:border-[#f0c14b] hover:shadow-[6px_6px_0_0_#f0c14b]">
              <div class="mb-4 flex items-center justify-between text-sm uppercase tracking-[0.2em] text-[#d8d0c1]">
                <span>{fixture.stage}</span>
                <span>⚽</span>
              </div>
              <div class="flex items-center justify-between gap-3">
                <div class="text-left">
                  <div class="text-3xl">{fixture.homeFlag}</div>
                  <p class="mt-2 font-semibold">{fixture.homeTeam}</p>
                </div>
                <div class="rounded-full border border-[#f5f0e6]/20 px-3 py-1 text-sm font-semibold">VS</div>
                <div class="text-right">
                  <div class="text-3xl">{fixture.awayFlag}</div>
                  <p class="mt-2 font-semibold">{fixture.awayTeam}</p>
                </div>
              </div>
              <div class="mt-6 border-t border-[#f5f0e6]/10 pt-4 text-sm text-[#d8d0c1]">
                <p>{fixture.date}</p>
                <p class="mt-1">Kickoff {fixture.time}</p>
              </div>
            </a>
          ))}
        </div>
      </section>
    </main>

    <Footer />
  </div>
</Layout>
