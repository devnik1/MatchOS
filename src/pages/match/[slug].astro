---

<Layout title={`${match.homeTeam} vs ${match.awayTeam} — MatchIQ`}>
  <div class="mx-auto flex min-h-screen max-w-7xl flex-col px-4 py-6 sm:px-6 lg:px-8">
    <Navigation />

    <main class="flex-1 py-8 sm:py-12">
      <section class="mb-10 overflow-hidden rounded-[2rem] border border-[#f5f0e6]/20 bg-[#171717] shadow-[8px_8px_0_0_#f0c14b]">
        <div class="grid gap-8 p-6 sm:p-10 lg:grid-cols-[1.2fr_0.8fr] lg:p-12">
          <div>
            <p class="mb-4 text-sm font-semibold uppercase tracking-[0.3em] text-[#7fd8ff]">{match.stage}</p>
            <div class="flex flex-wrap items-end gap-4 sm:gap-6">
              <div class="min-w-[140px]">
                <div class="text-5xl sm:text-6xl">{match.homeFlag}</div>
                <p class="mt-3 text-2xl font-black sm:text-3xl">{match.homeTeam}</p>
                <p class="mt-1 text-sm uppercase tracking-[0.2em] text-[#d8d0c1]">FIFA #{match.homeRanking}</p>
              </div>
              <div class="rounded-full border border-[#f5f0e6]/20 px-4 py-2 text-2xl font-black">VS</div>
              <div class="min-w-[140px] text-right">
                <div class="text-5xl sm:text-6xl">{match.awayFlag}</div>
                <p class="mt-3 text-2xl font-black sm:text-3xl">{match.awayTeam}</p>
                <p class="mt-1 text-sm uppercase tracking-[0.2em] text-[#d8d0c1]">FIFA #{match.awayRanking}</p>
              </div>
            </div>
          </div>
          <div class="rounded-[1.5rem] border border-[#f5f0e6]/20 bg-[#222222] p-6">
            <MatchDetails match={match} />
          </div>
        </div>
      </section>

      {match.homeProbability && match.awayProbability && <WinProbability home={match.homeProbability} away={match.awayProbability} homeTeam={match.homeTeam} awayTeam={match.awayTeam} />}

      <PlayersToWatch home={match.players.home} away={match.players.away} homeTeam={match.homeTeam} awayTeam={match.awayTeam} />

      <section class="mb-10">
        <div class="mb-6">
          <p class="text-sm font-semibold uppercase tracking-[0.3em] text-[#ff6b6b]">Key matchups</p>
          <h2 class="text-2xl font-black sm:text-3xl">Three battles that could decide the game</h2>
        </div>
        <div class="grid gap-4 md:grid-cols-3">
          {match.matchups.map((matchup) => <MatchupCard matchup={matchup} />)}
        </div>
      </section>

      <HeadToHead data={match.h2h} />

      <RecentForm home={match.form.home} away={match.form.away} homeTeam={match.homeTeam} awayTeam={match.awayTeam} />

      <section class="mb-10">
        <div class="mb-6">
          <p class="text-sm font-semibold uppercase tracking-[0.3em] text-[#f0c14b]">Storylines</p>
          <h2 class="text-2xl font-black sm:text-3xl">The narratives shaping the fixture</h2>
        </div>
        <div class="grid gap-4 lg:grid-cols-3">
          {match.storylines.map((storyline) => <StorylineCard storyline={storyline} />)}
        </div>
      </section>

      <section class="mb-10 grid gap-4 lg:grid-cols-2">
        <TacticalCard team={match.tactics.home} title={`${match.homeTeam} shape`} accent="border-[#7fd8ff]" />
        <TacticalCard team={match.tactics.away} title={`${match.awayTeam} shape`} accent="border-[#ff6b6b]" />
      </section>
    </main>

    <Footer />
  </div>
</Layout>
