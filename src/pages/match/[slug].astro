---
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';
import MatchDetails from '../../components/MatchDetails.astro';
import WinProbability from '../../components/WinProbability.astro';
import PlayersToWatch from '../../components/PlayersToWatch.astro';
import MatchupCard from '../../components/MatchupCard.astro';
import HeadToHead from '../../components/HeadToHead.astro';
import RecentForm from '../../components/RecentForm.astro';
import StorylineCard from '../../components/StorylineCard.astro';
import TacticalCard from '../../components/TacticalCard.astro';

export async function getStaticPaths() {
  return [{ params: { slug: 'spain-vs-portugal' } }];
}

const { slug } = Astro.params;
const matches = {
  'spain-vs-portugal': {
    homeTeam: 'Spain',
    awayTeam: 'Portugal',
    homeFlag: '🇪🇸',
    awayFlag: '🇵🇹',
    homeRanking: 8,
    awayRanking: 7,
    date: '15 Jul 2026',
    kickoff: '20:00',
    stadium: 'AT&T Stadium',
    competition: 'FIFA World Cup',
    stage: 'Semi-Final',
    homeProbability: 55,
    awayProbability: 45,
    players: {
      home: [
        { number: 10, name: 'Lamine Yamal', position: 'RW', rating: 8.8, stat: '3.4 successful dribbles' },
        { number: 16, name: 'Unai Simón', position: 'GK', rating: 8.0, stat: '84% save rate' },
        { number: 5, name: 'Pau Cubarsí', position: 'CB', rating: 8.1, stat: '3.0 clearances' }
      ],
      away: [
        { number: 8, name: 'Bruno Fernandes', position: 'AM', rating: 8.6, stat: '4.2 key passes' },
        { number: 26, name: 'Diogo Costa', position: 'GK', rating: 8.2, stat: '78% save rate' },
        { number: 20, name: 'Vitinha', position: 'CM', rating: 8.3, stat: '91% pass accuracy' }
      ]
    },
    matchups: [
      { number: 10, name: 'Lamine Yamal', position: 'RW', rating: 8.8, stat: '3.4 successful dribbles', explanation: 'Yamal’s pace could unsettle Portugal’s full-backs if Spain attack in transition.' },
      { number: 8, name: 'Bruno Fernandes', position: 'AM', rating: 8.6, stat: '4.2 key passes', explanation: 'Fernandes can turn a tight game with one incisive pass into the box.' },
      { number: 20, name: 'Vitinha', position: 'CM', rating: 8.3, stat: '91% pass accuracy', explanation: 'Vitinha’s circulation will be key to Spain’s pressing rhythm.' }
    ],
    h2h: {
      overall: { wins: 7, draws: 5, losses: 4 },
      lastFive: [
        { date: '2022', score: '1-0', result: 'Spain win' },
        { date: '2018', score: '2-3', result: 'Portugal win' },
        { date: '2016', score: '0-0', result: 'Draw' },
        { date: '2014', score: '0-1', result: 'Portugal win' },
        { date: '2012', score: '1-2', result: 'Portugal win' }
      ],
      tournaments: [
        { date: '2018 World Cup', score: '2-3', result: 'Portugal win' },
        { date: '2012 Euro', score: '4-2', result: 'Spain win' },
        { date: '2004 Euro', score: '0-1', result: 'Portugal win' }
      ]
    },
    form: {
      home: [
        { opponent: 'Germany', ranking: 16, score: '2-1', result: 'Win' },
        { opponent: 'Italy', ranking: 6, score: '2-1', result: 'Win' },
        { opponent: 'England', ranking: 5, score: '2-1', result: 'Win' },
        { opponent: 'France', ranking: 4, score: '2-2', result: 'Draw' },
        { opponent: 'Netherlands', ranking: 9, score: '3-2', result: 'Win' }
      ],
      away: [
        { opponent: 'Switzerland', ranking: 20, score: '2-1', result: 'Win' },
        { opponent: 'Croatia', ranking: 10, score: '1-0', result: 'Win' },
        { opponent: 'Slovenia', ranking: 24, score: '2-0', result: 'Win' },
        { opponent: 'Denmark', ranking: 12, score: '2-1', result: 'Win' },
        { opponent: 'Czechia', ranking: 18, score: '2-1', result: 'Win' }
      ]
    },
    storylines: [
      'Spain have looked sharp in transition and have created overloads on the wings.',
      'Portugal carry dangerous individual quality in the final third.',
      'This fixture promises a technical, high-intensity semifinal battle.'
    ],
    tactics: {
      home: { formation: '4-3-3', playingStyle: 'Position play', attackingStyle: 'Short passing', defensiveStyle: 'High line', strengths: ['Ball circulation', 'Wide overloads'], weaknesses: ['Space behind full-backs'] },
      away: { formation: '4-2-3-1', playingStyle: 'Counter-pressing', attackingStyle: 'Quick combinations', defensiveStyle: 'Mid-block', strengths: ['Individual quality', 'Set-piece threat'], weaknesses: ['Defensive balance'] }
    }
  }
};

const match = matches[slug as keyof typeof matches] || matches['spain-vs-portugal'];
---

<Layout title={`${match.homeTeam} vs ${match.awayTeam} — MatchIQ`}>
  <div class="mx-auto flex min-h-screen max-w-7xl flex-col px-4 py-6 sm:px-6 lg:px-8">
    <Navigation />

    <main class="flex-1 py-8 sm:py-12">
      <section class="mb-10 overflow-hidden rounded-[2rem] border border-[#f5f0e6]/20 bg-[#171717] shadow-[8px_8px_0_0_#f0c14b]">
        <div class="grid gap-8 p-6 sm:p-10 lg:grid-cols-[1.2fr_0.8fr] lg:p-12">
          <div>
            <p class="mb-4 text-sm font-semibold uppercase tracking-[0.3em] text-[#7fd8ff]">{match.stage}</p>
            <div class="flex flex-wrap items-end gap-4 sm:gap-6">
              <div class="min-w-[140px]">
                <div class="text-5xl sm:text-6xl">{match.homeFlag}</div>
                <p class="mt-3 text-2xl font-black sm:text-3xl">{match.homeTeam}</p>
                <p class="mt-1 text-sm uppercase tracking-[0.2em] text-[#d8d0c1]">FIFA #{match.homeRanking}</p>
              </div>
              <div class="rounded-full border border-[#f5f0e6]/20 px-4 py-2 text-2xl font-black">VS</div>
              <div class="min-w-[140px] text-right">
                <div class="text-5xl sm:text-6xl">{match.awayFlag}</div>
                <p class="mt-3 text-2xl font-black sm:text-3xl">{match.awayTeam}</p>
                <p class="mt-1 text-sm uppercase tracking-[0.2em] text-[#d8d0c1]">FIFA #{match.awayRanking}</p>
              </div>
            </div>
          </div>
          <div class="rounded-[1.5rem] border border-[#f5f0e6]/20 bg-[#222222] p-6">
            <MatchDetails match={match} />
          </div>
        </div>
      </section>

      {match.homeProbability && match.awayProbability && <WinProbability home={match.homeProbability} away={match.awayProbability} homeTeam={match.homeTeam} awayTeam={match.awayTeam} />}

      <PlayersToWatch home={match.players.home} away={match.players.away} homeTeam={match.homeTeam} awayTeam={match.awayTeam} />

      <section class="mb-10">
        <div class="mb-6">
          <p class="text-sm font-semibold uppercase tracking-[0.3em] text-[#ff6b6b]">Key matchups</p>
          <h2 class="text-2xl font-black sm:text-3xl">Three battles that could decide the game</h2>
        </div>
        <div class="grid gap-4 md:grid-cols-3">
          {match.matchups.map((matchup) => <MatchupCard matchup={matchup} />)}
        </div>
      </section>

      <HeadToHead data={match.h2h} />

      <RecentForm home={match.form.home} away={match.form.away} homeTeam={match.homeTeam} awayTeam={match.awayTeam} />

      <section class="mb-10">
        <div class="mb-6">
          <p class="text-sm font-semibold uppercase tracking-[0.3em] text-[#f0c14b]">Storylines</p>
          <h2 class="text-2xl font-black sm:text-3xl">The narratives shaping the fixture</h2>
        </div>
        <div class="grid gap-4 lg:grid-cols-3">
          {match.storylines.map((storyline) => <StorylineCard storyline={storyline} />)}
        </div>
      </section>

      <section class="mb-10 grid gap-4 lg:grid-cols-2">
        <TacticalCard team={match.tactics.home} title={`${match.homeTeam} shape`} accent="border-[#7fd8ff]" />
        <TacticalCard team={match.tactics.away} title={`${match.awayTeam} shape`} accent="border-[#ff6b6b]" />
      </section>
    </main>

    <Footer />
  </div>
</Layout>
